{
  "name": "react-training-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "backend": "cd ../backend && npm start",
    "dev": "vite --port 3000",
    "check": "npm run prettier:check && npm run lint && tsc -b --noEmit",
    "check:fix": "npm run prettier:write && npm run lint:fix",
    "check:ts": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:browser": "vitest --project browser",
    "test:run": "vitest --run"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-devtools": "^5.106.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "msw": "^3.0.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
